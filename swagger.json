  "info": {
    "title": "Coupon Management System API",
    "description": "API documentation for Coupon Code Management System - Backend Technical Challenge",
    "version": "1.0",
    "contact": {}
  },
  "tags": [
    {
      "name": "auth",
      "description": "Authentication endpoints"
    },
    {
      "name": "coupons",
      "description": "Customer coupon endpoints"
    },
    {
      "name": "orders",
      "description": "Order management endpoints"
    },
    {
      "name": "admin",
      "description": "Admin management endpoints"
    }
  ],
  "servers": [],
  "components": {
    "securitySchemes": {
      "JWT-auth": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http",
        "name": "JWT",
        "description": "Enter JWT token",
        "in": "header"
      }
    },
    "schemas": {
      "RegisterDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "user@example.com",
            "description": "User email address"
          },
          "password": {
            "type": "string",
            "example": "password123",
            "description": "User password (min 6 characters)",
            "minLength": 6
          },
          "name": {
            "type": "string",
            "example": "John Doe",
            "description": "User full name"
          },
          "phone": {
            "type": "string",
            "example": "+1234567890",
            "description": "User phone number"
          },
          "role": {
            "type": "string",
            "enum": [
              "customer",
              "admin"
            ],
            "description": "User role",
            "default": "customer"
          },
          "referralCode": {
            "type": "string",
            "example": "REF-ABC123",
            "description": "Referral code (optional)"
          }
        },
        "required": [
          "email",
          "password",
          "name",
          "phone"
        ]
      },
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "user@example.com",
            "description": "User email address"
          },
          "password": {
            "type": "string",
            "example": "password123",
            "description": "User password"
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "CartItemDto": {
        "type": "object",
        "properties": {
          "productId": {
            "type": "string",
            "example": "prod-123",
            "description": "Product ID"
          },
          "category": {
            "type": "string",
            "example": "electronics",
            "description": "Product category"
          },
          "quantity": {
            "type": "number",
            "example": 1,
            "description": "Product quantity"
          },
          "price": {
            "type": "number",
            "example": 1000,
            "description": "Product price"
          }
        },
        "required": [
          "productId"
        ]
      },
      "ValidateCouponDto": {
        "type": "object",
        "properties": {
          "cartValue": {
            "type": "number",
            "example": 1000,
            "description": "Cart value in currency units"
          },
          "items": {
            "description": "Cart items",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CartItemDto"
            }
          },
          "paymentMethod": {
            "type": "string",
            "example": "card",
            "description": "Payment method",
            "default": "card"
          }
        },
        "required": [
          "cartValue"
        ]
      },
      "Object": {
        "type": "object",
        "properties": {}
      },
      "RecommendCouponDto": {
        "type": "object",
        "properties": {
          "cartValue": {
            "type": "number",
            "example": 1500,
            "description": "Cart value in currency units"
          },
          "items": {
            "description": "Cart items",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CartItemDto"
            }
          },
          "userId": {
            "type": "string",
            "example": "user123",
            "description": "User ID (optional, will use current user if not provided)"
          }
        },
        "required": [
          "cartValue"
        ]
      },
      "OrderItemDto": {
        "type": "object",
        "properties": {
          "productId": {
            "type": "string",
            "example": "prod-123",
            "description": "Product ID"
          },
          "quantity": {
            "type": "number",
            "example": 2,
            "description": "Quantity of items",
            "minimum": 1
          },
          "price": {
            "type": "number",
            "example": 500,
            "description": "Price per item",
            "minimum": 0
          },
          "category": {
            "type": "string",
            "example": "electronics",
            "description": "Product category"
          }
        },
        "required": [
          "productId",
          "quantity",
          "price"
        ]
      },
      "CreateOrderDto": {
        "type": "object",
        "properties": {
          "orderValue": {
            "type": "number",
            "example": 1000,
            "description": "Total order value before discount",
            "minimum": 0
          },
          "items": {
            "description": "Order items",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/OrderItemDto"
            }
          },
          "paymentMethod": {
            "type": "string",
            "example": "card",
            "description": "Payment method (card, upi, wallet)"
          },
          "couponCode": {
            "type": "string",
            "example": "FIRST50",
            "description": "Optional coupon code to apply"
          },
          "deliveryCharge": {
            "type": "number",
            "example": 50,
            "description": "Delivery charge",
            "minimum": 0
          }
        },
        "required": [
          "orderValue",
          "items",
          "paymentMethod"
        ]
      },
      "CreateCouponDto": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "example": "FIRST50",
            "description": "Unique coupon code"
          },
          "title": {
            "type": "string",
            "example": "50% off on first order",
            "description": "Coupon title"
          },
          "description": {
            "type": "string",
            "example": "Get 50% off on your first order",
            "description": "Coupon description"
          },
          "discountType": {
            "type": "string",
            "enum": [
              "percentage",
              "fixed_amount",
              "free_delivery"
            ],
            "example": "percentage",
            "description": "Type of discount"
          },
          "discountValue": {
            "type": "number",
            "example": 50,
            "description": "Discount value (percentage or fixed amount)",
            "minimum": 0
          },
          "minOrderValue": {
            "type": "number",
            "example": 500,
            "description": "Minimum order value required",
            "minimum": 0
          },
          "maxDiscountCap": {
            "type": "number",
            "example": 200,
            "description": "Maximum discount cap (required for percentage)",
            "minimum": 0
          },
          "startDate": {
            "format": "date-time",
            "type": "string",
            "example": "2024-01-01T00:00:00Z",
            "description": "Coupon start date"
          },
          "endDate": {
            "format": "date-time",
            "type": "string",
            "example": "2024-12-31T23:59:59Z",
            "description": "Coupon end date"
          },
          "isActive": {
            "type": "boolean",
            "example": true,
            "description": "Whether coupon is active",
            "default": true
          },
          "totalUsageLimit": {
            "type": "number",
            "example": 1000,
            "description": "Total usage limit for the coupon",
            "minimum": 1
          },
          "perUserLimit": {
            "type": "number",
            "example": 1,
            "description": "Usage limit per user",
            "minimum": 1
          },
          "applicableCategories": {
            "example": [
              "electronics",
              "groceries"
            ],
            "description": "Applicable product categories",
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "applicableProducts": {
            "example": [
              "prod-123",
              "prod-456"
            ],
            "description": "Applicable product IDs",
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "userSegment": {
            "type": "string",
            "enum": [
              "all",
              "new_users",
              "premium_users"
            ],
            "example": "new_users",
            "description": "Target user segment",
            "default": "all"
          },
          "minPurchaseCount": {
            "type": "number",
            "example": 3,
            "description": "Minimum purchase count required",
            "minimum": 0
          },
          "excludedCategories": {
            "example": [
              "clothing"
            ],
            "description": "Excluded product categories",
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "excludedProducts": {
            "example": [
              "prod-789"
