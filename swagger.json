        ]
      }
    },
    "/coupons/recommend": {
      "post": {
        "operationId": "CouponController_recommendCoupons",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RecommendCouponDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Recommended coupons with best coupon and alternatives",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "bestCoupon": {
                      "type": "object",
                      "nullable": true,
                      "properties": {
                        "code": {
                          "type": "string",
                          "example": "SAVE200"
                        },
                        "potentialSavings": {
                          "type": "number",
                          "example": 200
                        },
                        "coupon": {
                          "type": "object"
                        }
                      }
                    },
                    "alternativeCoupons": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "code": {
                            "type": "string"
                          },
                          "potentialSavings": {
                            "type": "number"
                          },
                          "coupon": {
                            "type": "object"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "security": [
          {
            "JWT-auth": []
          }
        ],
        "summary": "Get recommended coupons based on cart",
        "tags": [
          "coupons"
        ]
      }
    },
    "/orders": {
