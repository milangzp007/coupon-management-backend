    "/coupons/{code}/validate": {
      "post": {
        "operationId": "CouponController_validateCoupon",
        "parameters": [
          {
            "name": "code",
            "required": true,
            "in": "path",
            "description": "Coupon code",
            "schema": {
              "example": "FIRST50",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ValidateCouponDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Coupon validation result"
          }
        },
        "security": [
          {
            "JWT-auth": []
          }
        ],
        "summary": "Validate if coupon is valid for cart",
        "tags": [
          "coupons"
        ]
      }
    },
    "/coupons/{code}/apply": {
      "post": {
        "operationId": "CouponController_applyCoupon",
        "parameters": [
          {
            "name": "code",
            "required": true,
            "in": "path",
            "description": "Coupon code",
            "schema": {
              "example": "FIRST50",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Object"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Coupon applied successfully"
          },
          "400": {
            "description": "Invalid coupon or validation failed"
          }
        },
        "security": [
          {
            "JWT-auth": []
          }
        ],
        "summary": "Apply coupon to cart/order",
        "tags": [
          "coupons"
        ]
      }
    },
    "/coupons/my-usage": {
      "get": {
        "operationId": "CouponController_getMyUsage",
        "parameters": [],
